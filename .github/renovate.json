{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["before 6am"],
  "prConcurrentLimit": 5,
  "labels": ["dependencies"],
  "commitMessagePrefix": "chore(deps):",
  "packageRules": [
    {
      "matchPackageNames": ["!@xmtp/**"],
      "enabled": false
    },
    {
      "matchPackageNames": ["@xmtp/**"],
      "groupName": "xmtp",
      "ignoreUnstable": false
    }
  ]
}
